    <path android:fillColor="#380F0912"
        android:pathData="M0,10.8 C3,10.6 9,4 14,2.9 L14,4.5 C9,7.3 5,12.6 0,12.3 Z" />
    <!-- The band widens over the front, narrows at the edges and darkens as it wraps away. -->
    <path android:pathData="M0,10.2 C3,10 9,3.4 14,2.3 L14,3.8 C9,6.7 5,12 0,11.7 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="14" android:endY="0">
