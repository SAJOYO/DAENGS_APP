    </path>
    <path android:fillColor="#00000000" android:strokeColor="#28FFFFFF" android:strokeWidth="0.18"
        android:pathData="M1,10.6 C5,9.7 9,5.1 13,3.2 M2,11 C6,9.9 10,5.3 12,4.4" />
</vector>
