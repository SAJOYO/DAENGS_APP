         Identical top/bottom lighting permits repetition. This is a material, not direction. -->
    <path android:pathData="M0,0 H14 V14 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="14" android:endY="0">
                <item android:offset="0" android:color="#660F0B14" />
                <item android:offset="0.18" android:color="#140F0B14" />
                <item android:offset="0.38" android:color="#36FFF4E5" />
                <item android:offset="0.57" android:color="#18FFF4E5" />
                <item android:offset="0.76" android:color="#100F0B14" />
                <item android:offset="1" android:color="#800F0B14" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Fine woven fibers, deliberately below one pixel at the normal 14px route width. -->
    <path android:fillColor="#00000000" android:strokeColor="#28FFF5E7" android:strokeWidth="0.22"
        android:pathData="M1.5,0 C2,4 1,10 1.5,14 M3.5,0 C4,4 3,10 3.5,14 M5.5,0 C6,4 5,10 5.5,14 M7.5,0 C8,4 7,10 7.5,14 M9.5,0 C10,4 9,10 9.5,14 M11.5,0 C12,4 11,10 11.5,14" />
