<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 장소 지도의 현재 위치. 산책 추적용 FOREGROUND_SERVICE 권한은 geo 에 남고
         여기로 안 온다 - 지도 화면이 떠 있는 동안만 위치를 쓴다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      창밖 날씨를 그 자리 기준으로 받으려고 쓴다 (Open-Meteo).
      **정밀 위치는 안 받는다** — 시·군 단위면 충분하고, 장식 하나에 정밀 위치를
      묻는 건 과하다. 거부해도 앱은 그대로 돌아간다 (맑은 낮으로 떨어진다).
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 카카오톡으로 로그인하려면 그 앱이 깔려 있는지 물어봐야 한다. API 30 부터는
         여기 적어 두지 않으면 isKakaoTalkLoginAvailable() 이 무조건 false 라,
         톡이 깔려 있어도 웹 로그인으로 넘어간다. -->
    <queries>
        <package android:name="com.kakao.talk" />

        <!-- 사진 찍기. API 30 부터는 여기 없으면 카메라 앱이 있는지 물어봐도
             항상 "없다"가 나온다. 인텐트를 띄우는 것 자체는 되지만, 그러면
             카메라가 없는 기기에서 버튼이 눌리고 아무 일도 안 일어난다. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".DaengsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Daengs">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Daengs.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 카카오 로그인이 끝나면 이리로 돌아온다. 스킴의 키는 build.gradle.kts 가
             manifestPlaceholders 로 꽂는다 — 앱 키를 저장소에 안 넣으려는 것이다.
             키가 없으면 스킴이 "kakao" 가 되는데, 그때는 로그인 버튼 자체가 막혀 있어서
             이 액티비티로 올 일이 없다. -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="${kakaoScheme}" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- 카메라 앱에 "여기다 찍어 주세요" 하고 넘길 자리.
             API 24 부터 file:// 를 남의 앱에 넘기면 FileUriExposedException 이
             난다. 캐시 안의 한 폴더만 열어 준다 (res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>