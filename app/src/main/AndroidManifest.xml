<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      위치. **쓰는 곳이 둘이라 한 군데 모아 둔다.**

        COARSE   창밖 날씨(Open-Meteo) · 장소 지도
        FINE     장소 지도와 사용자가 시작한 산책 기록
        FGS      산책 중 화면이 꺼져도 위치 기록을 이어 간다
        알림     산책 기록 상태와 일시정지·종료 액션을 표시한다

      창밖 날씨는 **정밀 위치가 필요 없다** — 시·군 단위면 충분하고, 장식 하나에
      정밀 위치를 묻는 건 과하다. 거부해도 앱은 그대로 돌아간다(맑은 낮으로 떨어진다).
      지도가 FINE 을 받는 것은 별개이고, 날씨 때문에 받는 게 아니다.

      ⚠️ 예전에는 날씨와 지도가 **각각 선언해서 COARSE 가 두 번** 적혀 있었다.
      병합기가 합쳐 주므로 동작은 같았지만, 주석 둘이 서로 다른 이유를 대고 있어
      어느 쪽이 맞는지 알 수 없었다 — 특히 날씨 쪽 "정밀 위치는 안 받는다" 가
      지도가 들어온 뒤로는 앱 전체로는 사실이 아니게 됐다. 권한을 새로 쓸 곳이
      생기면 여기에 줄을 더하지 말고 **위 표에 한 줄 적는다.**
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 카카오톡으로 로그인하려면 그 앱이 깔려 있는지 물어봐야 한다. API 30 부터는
         여기 적어 두지 않으면 isKakaoTalkLoginAvailable() 이 무조건 false 라,
         톡이 깔려 있어도 웹 로그인으로 넘어간다. -->
    <queries>
        <package android:name="com.kakao.talk" />

        <!-- 사진 찍기. API 30 부터는 여기 없으면 카메라 앱이 있는지 물어봐도
             항상 "없다"가 나온다. 인텐트를 띄우는 것 자체는 되지만, 그러면
             카메라가 없는 기기에서 버튼이 눌리고 아무 일도 안 일어난다. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".DaengsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Daengs">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Daengs.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 카카오 로그인이 끝나면 이리로 돌아온다. 스킴의 키는 build.gradle.kts 가
             manifestPlaceholders 로 꽂는다 — 앱 키를 저장소에 안 넣으려는 것이다.
             키가 없으면 스킴이 "kakao" 가 되는데, 그때는 로그인 버튼 자체가 막혀 있어서
             이 액티비티로 올 일이 없다. -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="${kakaoScheme}" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- 카메라 앱에 "여기다 찍어 주세요" 하고 넘길 자리.
             API 24 부터 file:// 를 남의 앱에 넘기면 FileUriExposedException 이
             난다. 캐시 안의 한 폴더만 열어 준다 (res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".walk.WalkTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
